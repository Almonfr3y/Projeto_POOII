<!-- Tela Carrinho: alterar quantidade, remover item, ver subtotal e finalizar a compra. -->
<Window x:Class="LojaVirtual.View.FrmCarrinho"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carrinho" Width="920" Height="600"
        WindowStartupLocation="CenterOwner" Loaded="FrmCarrinho_Loaded">
    <!-- Grid com 2 linhas: itens (ocupa o resto) e a barra de baixo. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CanUserSortColumns False: a ordem das linhas fica igual à da lista de itens do carrinho. -->
        <DataGrid x:Name="dgItens" Grid.Row="0" IsReadOnly="True" SelectionMode="Single"
                  AutoGenerateColumns="True" CanUserSortColumns="False"
                  SelectionChanged="DgItens_SelectionChanged" />

        <!-- Barra de baixo: subtotal à esquerda, quantidade e botões à direita. -->
        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="Quantidade:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="txtQuantidade" Width="50" VerticalContentAlignment="Center" />
                <Button x:Name="btnAlterar" Content="Alterar" Height="32" Click="BtnAlterar_Click" />
                <Button x:Name="btnRemover" Content="Remover do carrinho" Height="32" Click="BtnRemover_Click" />
                <Button x:Name="btnFinalizar" Content="Finalizar Compra" Height="32" Click="BtnFinalizar_Click" />
            </StackPanel>
            <TextBlock x:Name="lblSubtotal" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
