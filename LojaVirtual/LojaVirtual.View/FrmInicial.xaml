<!-- Tela Inicial: busca, categorias, lista de peças e botões Carrinho, Favoritos e Meus Pedidos. -->
<Window x:Class="LojaVirtual.View.FrmInicial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loja Virtual de Peças" Width="920" Height="600"
        WindowStartupLocation="CenterScreen" Loaded="FrmInicial_Loaded">
    <!-- Grid com 4 linhas: busca, categoria, lista de peças (ocupa o resto) e botões de baixo. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Linha 0: busca à esquerda, botões das outras telas à direita. -->
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="btnCarrinho" Content="🛒 Carrinho" Click="BtnCarrinho_Click" />
                <Button x:Name="btnFavoritos" Content="⭐ Favoritos" Click="BtnFavoritos_Click" />
                <Button x:Name="btnMeusPedidos" Content="Meus Pedidos" Click="BtnMeusPedidos_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Pesquise aqui:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="txtBusca" Width="300" />
                <Button x:Name="btnBuscar" Content="Buscar" IsDefault="True" Click="BtnBuscar_Click" />
            </StackPanel>
        </DockPanel>

        <!-- Linha 1: filtro de categoria e a saudação ao cliente. -->
        <DockPanel Grid.Row="1" Margin="0,10">
            <TextBlock x:Name="lblCliente" DockPanel.Dock="Right" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Categoria:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="cmbCategoria" Width="220" SelectionChanged="CmbCategoria_SelectionChanged" />
            </StackPanel>
        </DockPanel>

        <!-- Linha 2: a lista de peças. As colunas são criadas sozinhas a partir dos dados (AutoGenerateColumns). -->
        <!-- CanUserSortColumns False: a ordem das linhas fica igual à da lista _produtos (o código usa a posição). -->
        <DataGrid x:Name="dgProdutos" Grid.Row="2" IsReadOnly="True" SelectionMode="Single"
                  AutoGenerateColumns="True" CanUserSortColumns="False" />

        <!-- Linha 3: botões de ação, alinhados à direita. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnFavoritar" Content="⭐ Favoritar" Height="32" Click="BtnFavoritar_Click" />
            <Button x:Name="btnAdicionar" Content="Adicionar ao carrinho" Height="32" Click="BtnAdicionar_Click" />
        </StackPanel>
    </Grid>
</Window>
