<!-- Checkout em etapas: Endereço -> Entrega -> Pagamento -> Revisão -> Concluído. -->
<!-- Os 5 painéis ficam no mesmo lugar (linha 1 do Grid); o código deixa visível só o da etapa atual. -->
<Window x:Class="LojaVirtual.View.FrmCheckout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finalizar compra" Width="920" Height="600"
        WindowStartupLocation="CenterOwner" Loaded="FrmCheckout_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Título da etapa, ex.: "Etapa 2 de 5 - Entrega". -->
        <TextBlock x:Name="lblEtapa" Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

        <!-- Etapa 1: endereço. -->
        <DockPanel x:Name="pnlEndereco" Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="Escolha o endereço de entrega:" Margin="0,0,0,4" />
            <ListBox x:Name="lstEnderecos" />
        </DockPanel>

        <!-- Etapa 2: entrega. -->
        <DockPanel x:Name="pnlEntrega" Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="Escolha a forma de entrega (frete calculado pelo peso do carrinho):"
                       Margin="0,0,0,4" />
            <ListBox x:Name="lstEntregas" />
        </DockPanel>

        <!-- Etapa 3: pagamento. GroupName igual = só um RadioButton pode ficar marcado. -->
        <StackPanel x:Name="pnlPagamento" Grid.Row="1">
            <RadioButton x:Name="rdoPix" Content="Pix" GroupName="Forma" Margin="0,0,0,8"
                         Checked="FormaDePagamento_Checked" />
            <RadioButton x:Name="rdoBoleto" Content="Boleto bancário" GroupName="Forma" Margin="0,0,0,8"
                         Checked="FormaDePagamento_Checked" />
            <RadioButton x:Name="rdoCartao" Content="Cartão de crédito" GroupName="Forma" Margin="0,0,0,8"
                         Checked="FormaDePagamento_Checked" />

            <GroupBox x:Name="grpCartao" Header="Dados do cartão" Width="420" HorizontalAlignment="Left">
                <!-- Grid de 2 colunas: rótulo à esquerda, campo à direita. -->
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome do titular:" VerticalAlignment="Center" />
                    <TextBox x:Name="txtTitular" Grid.Row="0" Grid.Column="1" Margin="0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Número:" VerticalAlignment="Center" />
                    <TextBox x:Name="txtNumeroCartao" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Parcelas:" VerticalAlignment="Center" />
                    <ComboBox x:Name="cmbParcelas" Grid.Row="2" Grid.Column="1" Width="70"
                              HorizontalAlignment="Left" Margin="0,4" />
                </Grid>
            </GroupBox>
        </StackPanel>

        <!-- Etapa 4: revisão (texto só para leitura). -->
        <TextBox x:Name="txtRevisao" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

        <!-- Etapa 5: concluído (comprovante). -->
        <TextBox x:Name="txtConcluido" Grid.Row="1" IsReadOnly="True" FontSize="16" TextWrapping="Wrap" />

        <!-- Botões de navegação entre as etapas. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnVoltar" Content="Voltar" Width="140" Height="32" Click="BtnVoltar_Click" />
            <Button x:Name="btnAvancar" Content="Avançar" Width="180" Height="32" Click="BtnAvancar_Click" />
        </StackPanel>
    </Grid>
</Window>
