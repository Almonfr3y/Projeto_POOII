<!-- Tela Favoritos: pesquisar, desfavoritar e mandar para o carrinho. -->
<Window x:Class="LojaVirtual.View.FrmFavoritos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Favoritos" Width="920" Height="600"
        WindowStartupLocation="CenterOwner" Loaded="FrmFavoritos_Loaded">
    <!-- Grid com 3 linhas: busca, lista (ocupa o resto) e botões. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Pesquise um favorito:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="txtBusca" Width="300" />
            <Button x:Name="btnBuscar" Content="Buscar" IsDefault="True" Click="BtnBuscar_Click" />
        </StackPanel>

        <!-- CanUserSortColumns False: a ordem das linhas fica igual à da lista _favoritosDaTela. -->
        <DataGrid x:Name="dgFavoritos" Grid.Row="1" IsReadOnly="True" SelectionMode="Single"
                  AutoGenerateColumns="True" CanUserSortColumns="False" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnDesfavoritar" Content="Desfavoritar" Height="32" Click="BtnDesfavoritar_Click" />
            <Button x:Name="btnAdicionar" Content="Adicionar ao carrinho" Height="32" Click="BtnAdicionar_Click" />
        </StackPanel>
    </Grid>
</Window>
