<!-- Tela Meus Pedidos: lista de pedidos (vinda do SQL puro) e o resumo embaixo. -->
<Window x:Class="LojaVirtual.View.FrmMeusPedidos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meus Pedidos" Width="920" Height="600"
        WindowStartupLocation="CenterOwner" Loaded="FrmMeusPedidos_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgPedidos" Grid.Row="0" IsReadOnly="True" AutoGenerateColumns="True" />

        <TextBlock x:Name="lblResumo" Grid.Row="1" FontSize="14" FontWeight="Bold" Margin="0,12,0,0" />
    </Grid>
</Window>
